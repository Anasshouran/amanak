# Environment variables example
# See https://12factor.net/config for more info

# Application
APP_NAME=
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Database
DB_CONNECTION=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=amanak
DB_USERNAME=amanak
DB_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Django
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CORS_ORIGIN_WHITELIST=

# Security engine
RULES_DIRECTORY=security-engine/rules
REPUTATION_ENABLED=false

# AI gateway
AI_ENABLED=false
AI_FAKE_PROVIDER=false
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT=15
AI_MAX_TOKENS=1024
AI_DAILY_LIMIT=100

# Django email (verification / password reset)
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=
FRONTEND_URL=

# Mail
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null