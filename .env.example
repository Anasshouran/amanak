# Environment variables example
# See https://12factor.net/config for more info

# Application
APP_NAME=
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Database
DB_CONNECTION=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=amanak
DB_USERNAME=amanak
DB_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Django
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CORS_ORIGIN_WHITELIST=

# Security engine
RULES_DIRECTORY=security-engine/rules
REPUTATION_ENABLED=false

# AI gateway
AI_ENABLED=false
AI_FAKE_PROVIDER=false
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT=15
AI_MAX_TOKENS=1024
AI_DAILY_LIMIT=100
# P19.2 — AI Assistant (local Ollama, disabled by default)
AI_ENABLED=false
AI_FAKE_PROVIDER=false
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=30

# P20.4 — Hybrid AI (cloud + local)
# When AI_PROVIDER is a cloud provider (openai, anthropic, groq), cloud consent
# is required (decision B — URLs redacted before transmission).
AI_CLOUD_CONSENT=false
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_REFERER=
OPENROUTER_TITLE=AMANAK
# Redaction policy: cloud uses aggressive redaction; local Ollama uses light redaction.
AI_CLOUD_REDACTION=aggressive
