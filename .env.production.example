# AMANAK production environment template (P6).
#
# Copy to `.env.production` (gitignored) and fill in real values:
#   cp .env.production.example .env.production
#
# NEVER commit `.env.production` and never reuse the development SECRET_KEY.

# --- Application -----------------------------------------------------------
APP_ENV=production
DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=your-domain.example
CORS_ALLOWED_ORIGINS=https://your-domain.example
# Public origin used in email links. Must be reachable by the user.
# Example prod value: https://amanak.example
PUBLIC_BASE_URL=https://amanak.example

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=amanak
POSTGRES_USER=amanak
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (throttle counters) --------------------------------------------
REDIS_URL=redis://redis:6379/1

# --- AI (keep disabled until explicitly approved) --------------------------
AI_ENABLED=False
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=

# --- Email (verification + password reset) --------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@your-domain.example

# --- Domain / TLS (used by certbot and nginx) ------------------------------
DOMAIN=your-domain.example
LETSENCRYPT_EMAIL=admin@your-domain.example
