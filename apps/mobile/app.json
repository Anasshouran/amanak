{
  "expo": {
    "name": "AMANAK أمانك",
    "slug": "amanak",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "amanak",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f172a",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "local.amanak.app"
    },
    "android": {
      "package": "local.amanak.app",
      "versionCode": 1,
      "allowBackup": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "./plugins/withMinimalPermissions",
      [
        "expo-camera",
        {
          "cameraPermission": "AMANAK uses the camera only to scan 2FA QR codes on your device.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}